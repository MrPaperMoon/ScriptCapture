{
  "manifest_version": 3,
  "name": "ScriptCapture — Watch Together",
  "version": "0.5.0",
  "minimum_chrome_version": "125",
  "description": "Смотрите видео вместе, управляйте плеером с любого устройства и общайтесь по аудио или видео.",
  "icons": {
    "16": "icons/smart-display-16.png",
    "32": "icons/smart-display-32.png",
    "48": "icons/smart-display-48.png",
    "128": "icons/smart-display-128.png"
  },
  "permissions": [
    "offscreen",
    "storage",
    "tabs",
    "scripting",
    "activeTab",
    "debugger"
  ],
  "host_permissions": [
    "https://code.avito.ru/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/smart-display-16.png",
      "32": "icons/smart-display-32.png"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; frame-src 'self'"
  },
  "content_scripts": [
    {
      "matches": [
        "https://code.avito.ru/*"
      ],
      "js": [
        "room.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
